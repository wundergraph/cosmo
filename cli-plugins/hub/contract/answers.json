          "type": "object",
          "required": [
            "address",
            "schema",
            "name",
            "source",
            "routerStatus",
            "endpointUrl",
            "sharing",
            "openPortals",
            "proposalOutcome"
          ],
          "properties": {
            "address": {
              "type": "string",
              "description": "How tools name it: <schema>/<sandbox>."
            },
            "schema": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "name",
                    "deleted"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "schema",
                        "sandbox",
