          "run_collection",
          "propose",
          "update_egress",
          "apply_config",
          "agent_run",
          "open_portal",
          "suspend_sandbox",
          "ask_ai",
          "yoko_call",
          "storage_snapshot"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "needs_approval",
          "needs_input",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "title": {
        "type": "string"
      },
      "origin": {
        "type": "string",
        "enum": [
          "ui",
          "cli",
          "mcp",
          "ci",
          "integration",
          "system"
        ]
      },
      "sandbox": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The sandbox it is about, <schema>/<sandbox>; null for an organization-wide operation such as an egress change."
      },
      "requestedBy": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The id of the person who started it; null when Hub did."
      },
      "agentName": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "finishedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "dashboardUrl": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "list_operations": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "operations"
    ],
    "properties": {
      "operations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "operationId",
            "kind",
            "status",
            "title",
            "origin",
            "sandbox",
            "requestedBy",
            "agentName",
            "createdAt",
            "finishedAt",
            "dashboardUrl"
          ],
          "properties": {
            "operationId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "launch_sandbox",
                "wake_sandbox",
                "delete_sandbox",
                "build_router",
                "setup_hub",
                "sync_pull_request",
                "add_source",
                "set_router_version",
                "set_router_modules",
                "use_router_image",
                "run_collection",
                "propose",
                "update_egress",
                "apply_config",
                "agent_run",
                "open_portal",
                "suspend_sandbox",
                "ask_ai",
                "yoko_call",
                "storage_snapshot"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "needs_approval",
                "needs_input",
                "succeeded",
                "failed",
                "cancelled"
              ]
            },
            "title": {
              "type": "string"
            },
            "origin": {
              "type": "string",
              "enum": [
                "ui",
                "cli",
                "mcp",
                "ci",
                "integration",
                "system"
              ]
            },
            "sandbox": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The sandbox it is about, <schema>/<sandbox>; null for an organization-wide operation such as an egress change."
            },
            "requestedBy": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The id of the person who started it; null when Hub did."
            },
            "agentName": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "finishedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dashboardUrl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "run_collection": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "sandbox",
      "passed",
      "failed",
      "results"
    ],
    "properties": {
      "sandbox": {
        "type": "string",
        "description": "The sandbox the operations ran against, <schema>/<sandbox>."
      },
      "passed": {
        "type": "number"
      },
      "failed": {
        "type": "number"
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "collection",
            "operation",
            "passed",
            "status",
            "durationMs",
            "response",
            "error"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "passed": {
              "type": "boolean"
            },
            "status": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "response": {
              "type": "string",
              "description": "The response body, or why the operation did not run."
            },
            "error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Why the operation failed, or null when it passed."
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "create_proposal": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "ok"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "open_portal": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "portal",
      "credential",
      "tunnelPath",
      "connectCommand",
      "dashboardUrl"
    ],
    "properties": {
      "portal": {
        "type": "object",
        "required": [
          "portalId",
          "subgraph",
          "status",
          "upstream",
          "openedBy",
          "lastRequestAt",
          "operationId"
        ],
        "properties": {
          "portalId": {
            "type": "string"
          },
          "subgraph": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "connecting",
              "connected",
              "disconnected",
              "closed"
            ],
            "description": "connecting: waiting for wgcm; connected: requests reach the service; disconnected: wgcm lost its connection, and the sandbox mocks the subgraph until wgcm connects again; closed: the sandbox serves the subgraph as before."
          },
          "upstream": {
            "type": "string",
            "enum": [
              "tunnel",
              "url"
            ],
            "description": "tunnel: wgcm on someone’s machine answers; url: Hub calls a service itself, such as an agent run’s workspace."
          },
          "openedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastRequestAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "credential": {
        "type": "string",
        "description": "Shown once. wgcm presents it on the tunnel; closing the portal revokes it."
      },
      "tunnelPath": {
        "type": "string",
        "description": "Where wgcm opens the tunnel, relative to the Hub URL."
      },
      "connectCommand": {
        "type": "string"
      },
      "dashboardUrl": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
