  "describe_current_access": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "organizationSlug",
      "role",
      "canMakeChanges",
      "token",
      "governanceSync",
      "activeSandbox"
    ],
    "properties": {
      "organizationSlug": {
        "type": "string"
      },
      "role": {
        "type": "string",
        "enum": [
          "editor",
          "viewer"
        ]
      },
      "canMakeChanges": {
        "type": "boolean",
        "description": "Whether you can change sandboxes: your role allows it and, with a token, it grants \"edit\"."
      },
      "token": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "name",
              "actions",
              "wholeOrganization",
              "scope"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "wholeOrganization": {
                "type": "boolean"
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The schemas and sandboxes (<schema>/<sandbox>) the token reaches; empty when wholeOrganization."
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "The agent token in use, or null in the app."
      },
      "governanceSync": {
        "type": "object",
        "required": [
          "syncedAt",
          "failure"
        ],
        "properties": {
          "syncedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When members, groups and owners last synced from Cosmo (ISO 8601); null when the organization is not linked to Cosmo."
          },
          "failure": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "reason",
                  "since"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "since": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Why syncing from Cosmo fails and since when; null while it works. Changes made in Cosmo Studio do not reach Hub until it works again."
          }
        },
        "additionalProperties": false
      },
      "activeSandbox": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "address",
              "isSchema",
              "isProtected",
              "protectedReason"
            ],
            "properties": {
              "address": {
                "type": "string"
              },
              "isSchema": {
                "type": "boolean"
              },
              "isProtected": {
                "type": "boolean"
              },
              "protectedReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "registryBackedMain",
                      "proposalApproved",
                      "proposalPublished"
                    ],
                    "description": "Why this version cannot be edited directly. \"registryBackedMain\": it is the mainline and is kept in sync with a schema registry. \"proposalApproved\": its review is settled and it waits to be published. \"proposalPublished\": its change is in the schema; delete it. In every case, create a new sandbox from it or from the schema and work there.",
                    "title": "View protected reason"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "The sandbox the app has open, or null. isSchema means it is the read-only schema."
      }
    },
    "additionalProperties": false
  }
