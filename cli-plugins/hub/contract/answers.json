{
  "launch_sandbox": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "address",
      "schema",
      "name",
      "source",
      "routerStatus",
      "endpointUrl",
      "sharing",
      "openPortals",
      "proposalOutcome",
      "url",
      "operationId",
      "status",
      "dashboardUrl"
    ],
    "properties": {
      "address": {
        "type": "string",
        "description": "How tools name it: <schema>/<sandbox>."
      },
      "schema": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "source": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "name",
              "deleted"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "schema",
                  "sandbox",
                  "cosmo"
                ]
              },
              "name": {
                "type": "string"
              },
              "deleted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "What it was launched from: a schema, a schema that follows a Cosmo graph, or another sandbox. A deleted source sandbox keeps its name, with deleted true; it keeps working, but update_from_source has nothing to bring in. Null when not recorded."
      },
      "routerStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "starting",
          "failed"
        ],
        "description": "How the sandbox’s router answers now: live, ready (starts on the first request), starting, or failed (it did not start; get_router_status says why and retry_router starts it again)."
      },
      "endpointUrl": {
        "type": "string"
      },
      "sharing": {
        "type": "string",
        "enum": [
          "private",
          "shared"
        ],
        "description": "private: only its creator can open it; shared: everyone in the organization can open it. Change it with set_sharing."
      },
      "openPortals": {
        "type": "number",
        "description": "How many of its subgraphs a portal serves from someone’s machine; list_portals shows them."
      },
      "proposalOutcome": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "outcome",
              "at",
              "next"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "published",
                  "rejected"
                ]
              },
              "at": {
                "type": "string"
              },
              "next": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "How its proposal was decided, or null while none was. published: its change is in the schema and it takes no more changes. rejected: someone else closed the proposal."
      },
      "url": {
        "type": "string",
        "description": "Where a person opens the sandbox in Hub."
      },
      "operationId": {
        "type": "string",
        "description": "The launch operation that starts the sandbox’s box; follow it with get_operation, or as an MCP task."
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "needs_approval",
          "needs_input",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "dashboardUrl": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "export_sandbox_config": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "sandbox_yaml",
      "router_version",
      "sources"
    ],
    "properties": {
      "sandbox_yaml": {
        "type": "string"
      },
      "router_version": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "The subgraph names, in the order the file lists them."
      }
    },
    "additionalProperties": false
  },
  "get_sandbox": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "address",
      "endpointUrl",
      "routerStatus",
      "viewSeq",
      "source",
      "sharing",
      "openPortals",
      "proposalOutcome"
    ],
    "properties": {
      "address": {
        "type": "string"
      },
      "endpointUrl": {
        "type": "string"
      },
      "endpointToken": {
        "type": "string",
        "description": "Send as Authorization: Bearer <token> to endpointUrl. Left out when this token does not grant \"run\"."
      },
      "routerStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "starting",
          "failed"
        ],
        "description": "How the sandbox’s router answers now: live, ready (starts on the first request), starting, or failed (it did not start; get_router_status says why and retry_router starts it again)."
      },
      "viewSeq": {
        "type": "number"
      },
      "source": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "name",
              "deleted"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "schema",
                  "sandbox",
                  "cosmo"
                ]
              },
              "name": {
                "type": "string"
              },
              "deleted": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "What it was launched from: a schema, a schema that follows a Cosmo graph, or another sandbox. A deleted source sandbox keeps its name, with deleted true; it keeps working, but update_from_source has nothing to bring in. Null when not recorded."
      },
      "sharing": {
        "type": "string",
        "enum": [
          "private",
          "shared"
        ],
        "description": "private: only its creator can open it; shared: everyone in the organization can open it. Change it with set_sharing."
      },
      "openPortals": {
        "type": "number",
        "description": "How many of its subgraphs a portal serves from someone’s machine; list_portals shows them."
      },
      "proposalOutcome": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "outcome",
              "at",
              "next"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "published",
                  "rejected"
                ]
              },
              "at": {
                "type": "string"
              },
              "next": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ],
        "description": "How its proposal was decided, or null while none was. published: its change is in the schema and it takes no more changes. rejected: someone else closed the proposal."
      }
    },
    "additionalProperties": false
  },
  "list_sandboxes": {
