                  ]
                }
              },
              "required": [
                "kind",
                "userId"
              ]
            },
            "agentName": {
              "type": [
                "string",
                "null"
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "verdict": {
              "type": "string",
              "enum": [
                "applied",
                "refused"
              ]
            },
