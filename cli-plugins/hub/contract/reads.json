{
  "launch_sandbox": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "address": {
        "type": "string"
      },
      "schema": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "source": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "schema",
                  "sandbox",
                  "cosmo"
                ]
              },
              "name": {
                "type": "string"
              },
              "deleted": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "name",
              "deleted"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "routerStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "starting",
          "failed"
        ]
      },
      "endpointUrl": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "operationId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "needs_approval",
          "needs_input",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "dashboardUrl": {
        "type": "string"
      }
    },
    "required": [
      "address",
      "schema",
      "name",
      "source",
      "routerStatus",
      "endpointUrl",
      "url",
      "operationId",
      "status",
      "dashboardUrl"
    ]
  },
  "export_sandbox_config": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sandbox_yaml": {
        "type": "string"
      },
      "router_version": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "sandbox_yaml",
      "router_version",
      "sources"
    ]
  },
  "get_sandbox": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "address": {
        "type": "string"
      },
      "endpointUrl": {
        "type": "string"
      },
      "routerStatus": {
        "type": "string",
        "enum": [
          "live",
          "ready",
          "starting",
          "failed"
        ]
      }
    },
    "required": [
      "address",
      "endpointUrl",
      "routerStatus"
    ]
  },
  "list_sandboxes": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sandboxes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "schema",
                        "sandbox",
                        "cosmo"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "deleted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "deleted"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "routerStatus": {
              "type": "string",
              "enum": [
                "live",
                "ready",
                "starting",
                "failed"
              ]
            },
            "endpointUrl": {
              "type": "string"
            }
          },
          "required": [
            "address",
            "schema",
            "name",
            "source",
            "routerStatus",
            "endpointUrl"
          ]
        }
      }
    },
    "required": [
      "sandboxes"
    ]
  },
  "stream_logs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "notice": {
        "type": "string"
      },
      "untrustedData": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "level": {
                  "type": "string",
                  "enum": [
                    "debug",
                    "info",
                    "warn",
                    "error",
                    "fatal"
                  ]
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "router",
                    "agent",
                    "boot",
                    "build",
                    "command"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "level",
                "source",
                "message"
              ]
            }
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "lines",
          "cursor"
        ]
      }
    },
    "required": [
      "notice",
      "untrustedData"
    ]
  },
  "list_sandbox_history": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
