              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "seq",
            "operationId",
            "author",
            "agentName",
            "createdAt",
            "kind",
            "verdict",
            "refusalReason"
          ]
        }
      }
    },
    "required": [
      "entries"
    ]
  },
  "get_operation": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "needs_approval",
          "needs_input",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "title": {
        "type": "string"
      },
      "origin": {
        "type": "string",
        "enum": [
          "ui",
          "cli",
          "mcp",
          "ci",
          "integration",
          "system"
        ]
      },
      "sandbox": {
        "type": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "finishedAt": {
        "type": [
          "string",
          "null"
        ]
      },
      "dashboardUrl": {
        "type": "string"
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "running",
                "succeeded",
                "failed",
                "skipped"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "status",
            "detail"
          ]
        }
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "remediation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "message",
              "remediation"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "approval": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "operationId",
      "kind",
      "status",
      "title",
      "origin",
      "sandbox",
      "createdAt",
      "finishedAt",
      "dashboardUrl",
      "steps",
      "error",
      "approval"
    ]
  },
