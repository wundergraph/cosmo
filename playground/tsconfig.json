{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "typeRoots": ["./dist/index.d.ts", "node_modules/@types"],

    "paths": {
      "@/*": ["./src/*"],
      "@wundergraph/cosmo-shared/playground/incremental-delivery": ["../shared/src/playground/incremental-delivery.ts"],
      "@wundergraph/cosmo-shared/playground/defer-schema": ["../shared/src/playground/defer-schema.ts"]
    }
  },
  "include": ["src", "./index.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
